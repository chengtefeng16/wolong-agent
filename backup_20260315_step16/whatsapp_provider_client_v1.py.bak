from pathlib import Path
import json


class WhatsAppProviderClientV1:
    def __init__(self, config_path=None):
        if config_path is None:
            config_path = Path(__file__).resolve().parents[1] / "config" / "whatsapp_provider_placeholder_v1.json"
        self.config_path = Path(config_path)
        self.config = self._load_config()

    def _load_config(self):
        if not self.config_path.exists():
            return {}
        with open(self.config_path, "r", encoding="utf-8") as f:
            return json.load(f)

    def send_message(self, payload):
        payload = payload or {}

        if not self.config:
            return self._build_result(
                success=False,
                delivery_status="pending_manual",
                error_code="provider_config_missing",
                error_message="whatsapp provider config file not found",
                retryable=False,
                fallback_action="human_review",
            )

        if not self.config.get("enabled", False):
            return self._build_result(
                success=False,
                delivery_status="pending_manual",
                error_code="provider_disabled",
                error_message="whatsapp provider is disabled",
                retryable=False,
                fallback_action="human_review",
            )

        if self.config.get("access_token_placeholder") == "ACCESS_TOKEN_NOT_SET":
            return self._build_result(
                success=False,
                delivery_status="pending_manual",
                error_code="provider_not_configured",
                error_message="whatsapp provider access token not configured",
                retryable=False,
                fallback_action="human_review",
            )

        return self._build_result(
            success=True,
            delivery_status="sent",
            provider_message_id="mock_whatsapp_provider_message_id",
            error_code=None,
            error_message=None,
            retryable=False,
            fallback_action=None,
        )

    def _build_result(
        self,
        success,
        delivery_status,
        provider_message_id=None,
        error_code=None,
        error_message=None,
        retryable=False,
        fallback_action=None,
    ):
        return {
            "success": success,
            "delivery_status": delivery_status,
            "provider_message_id": provider_message_id,
            "error_code": error_code,
            "error_message": error_message,
            "retryable": retryable,
            "fallback_action": fallback_action,
        }


if __name__ == "__main__":
    client = WhatsAppProviderClientV1()
    result = client.send_message({"send_text": "hello"})
    print(json.dumps(result, ensure_ascii=False, indent=2))

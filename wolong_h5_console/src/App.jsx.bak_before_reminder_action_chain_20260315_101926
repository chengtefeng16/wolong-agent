function buildReminderList(customers, businessSnapshot) {
  const items = []
  const businessMap = new Map()

  ;(businessSnapshot?.customers || []).forEach((item) => {
    businessMap.set((item.customer_name || '').trim().toLowerCase(), item)
  })

  ;(customers || []).forEach((customer) => {
    const key = (customer.name || '').trim().toLowerCase()
    const business = businessMap.get(key)
    if (!business) return

    const reasons = []
    if (business.handoff_recommended) reasons.push('建议人工介入')
    if (business.risk_level === 'high') reasons.push('高风险')
    if (business.next_best_action === 'human_follow_up') reasons.push('待跟进')
    if (!reasons.length) return

    items.push({
      id: customer.id,
      customerName: customer.name,
      reasons,
      riskLevel: business.risk_level,
      handoffRecommended: business.handoff_recommended,
      nextBestAction: business.next_best_action,
      customerType: business.customer_type,
      businessStage: business.business_stage,
    })
  })

  return items
}

function getNotificationBody(reminder) {
  const parts = []
  if (reminder.reasons?.length) parts.push(reminder.reasons.join(' / '))
  parts.push(`建议动作：${getActionLabel(reminder.nextBestAction)}`)
  return parts.join(' ｜ ')
}

async function ensureBrowserNotificationPermission() {
  if (typeof window === 'undefined' || !('Notification' in window)) {
    return 'unsupported'
  }

  if (Notification.permission === 'granted') return 'granted'
  if (Notification.permission === 'denied') return 'denied'

  try {
    const permission = await Notification.requestPermission()
    return permission
  } catch {
    return 'error'
  }
}

function sendBrowserNotification(reminder) {
  if (typeof window === 'undefined' || !('Notification' in window)) return
  if (Notification.permission !== 'granted') return

  try {
    const notification = new Notification('卧龙Agent提醒', {
      body: `${reminder.customerName}：${getNotificationBody(reminder)}`,
      tag: `wolong-${reminder.customerName}`,
    })

    notification.onclick = () => {
      window.focus()
    }
  } catch (error) {
    console.error('browser notification failed', error)
  }
}


                </div>
              </div>

              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', paddingTop: '4px' }}>
                <button
                  onClick={() => setActiveReminder(null)}
                  style={{
                    height: '40px',
                    padding: '0 14px',
                    borderRadius: '10px',
                    border: '1px solid #d1d5db',
                    background: '#ffffff',
                    color: '#374151',
                    fontWeight: 700,
                    cursor: 'pointer',
                  }}
                >
                  稍后处理
                </button>

                <button
                  onClick={handleReminderJump}
                  style={{
                    height: '40px',
                    padding: '0 16px',
                    borderRadius: '10px',
                    border: '1px solid #2563eb',
                    background: '#2563eb',
                    color: '#ffffff',
                    fontWeight: 800,
                    cursor: 'pointer',
                  }}
                >
                  立即跟进
                </button>
              </div>
            </div>
          </div>
        </div>
      ) : null}

      <div
        style={{
          marginBottom: '10px',
          border: '1px solid #d7dde7',
          background: '#ffffff',
          borderRadius: '12px',
          padding: '10px 12px',
          display: 'grid',
          gridTemplateColumns: '1.2fr 1fr 1fr 1fr',
          gap: '10px',
        }}
      >
        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>待提醒</div>
          <div style={{ fontSize: '28px', fontWeight: 800 }}>{reminderStats.total}</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>建议人工介入</div>
          <div style={{ fontSize: '28px', fontWeight: 800, color: '#b91c1c' }}>{reminderStats.handoff}</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>高风险</div>
          <div style={{ fontSize: '28px', fontWeight: 800, color: '#b91c1c' }}>{reminderStats.highRisk}</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>待跟进</div>
          <div style={{ fontSize: '28px', fontWeight: 800, color: '#1d4ed8' }}>{reminderStats.followUp}</div>
        </div>
      </div>

      <div
        style={{
          marginBottom: '10px',
          border: '1px solid #d7dde7',
          background: '#ffffff',
          borderRadius: '12px',
          padding: '10px 12px',
          display: 'grid',
          gridTemplateColumns: '1.2fr 1fr 1fr 1fr',
          gap: '10px',
        }}
      >
        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>浏览器通知</div>
          <div style={{ fontSize: '15px', fontWeight: 800, marginBottom: '4px' }}>
            {browserNotifyEnabled ? '已开启' : '未开启'}
          </div>
          <div style={{ fontSize: '12px', color: '#6b7280' }}>状态：{browserNotifyStatus}</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>企业微信</div>
          <div style={{ fontSize: '15px', fontWeight: 800, marginBottom: '4px' }}>
            {wecomNotifyEnabled ? '占位已开' : '占位未开'}
          </div>
          <div style={{ fontSize: '12px', color: '#6b7280' }}>后续接 webhook</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>微信</div>
          <div style={{ fontSize: '15px', fontWeight: 800, marginBottom: '4px' }}>
            {wechatNotifyEnabled ? '占位已开' : '占位未开'}
          </div>
          <div style={{ fontSize: '12px', color: '#6b7280' }}>后续接桥接通道</div>
        </div>

        <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
          <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '6px' }}>钉钉</div>
          <div style={{ fontSize: '15px', fontWeight: 800, marginBottom: '4px' }}>
            {dingtalkNotifyEnabled ? '占位已开' : '占位未开'}
          </div>
          <div style={{ fontSize: '12px', color: '#6b7280' }}>后续接机器人 webhook</div>
        </div>
      </div>

      <div style={{ background: '#fff', border: '1px solid #d7dde7', borderRadius: '12px', padding: '10px 12px', marginBottom: '10px', boxShadow: '0 1px 2px rgba(0,0,0,0.03)' }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '12px', flexWrap: 'wrap', marginBottom: '8px' }}>
          <div>
            <div style={{ fontSize: '15px', fontWeight: 700 }}>WhatsApp 房间开关（运行时真源读取）</div>
            <div style={{ fontSize: '12px', color: '#6b7280', marginTop: '2px' }}>
              {loadingText}
            </div>
          </div>

          <button
            onClick={emergencyStop}
            style={{
              height: '34px',
              padding: '0 14px',
              borderRadius: '10px',
              border: '1px solid #ef4444',
              background: '#fff1f2',
              color: '#d92020',
              fontWeight: 700,
              cursor: 'pointer',
            }}
          >
            紧急止水（前端演示）
          </button>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1.2fr 1fr 1fr', gap: '10px', alignItems: 'stretch' }}>
          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '10px' }}>第1层 · 接入层</div>
            <div style={{ fontSize: '13px', fontWeight: 700, marginBottom: '8px' }}>WhatsApp 接入模式</div>
            <div style={{ fontSize: '14px', fontWeight: 700, marginBottom: '8px' }}>{getModeLabel(ingressMode)}</div>

            <div style={{ borderTop: '1px solid #e5e7eb', paddingTop: '6px' }}>
              <SwitchRow label="接入开关" checked={ingressMode !== 'off'} onClick={() => onTogglePlaceholder('接入开关')} />
            </div>
          </div>

          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '10px' }}>第2层 · 处理层</div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '2px' }}>
              <SwitchRow label="自动分类" checked={autoClassify} onClick={() => onTogglePlaceholder('自动分类')} />
              <SwitchRow label="自动标签" checked={autoTagging} onClick={() => onTogglePlaceholder('自动标签')} />
              <SwitchRow label="H5 可见" checked={h5Visible} onClick={() => onTogglePlaceholder('H5 可见')} />
            </div>
          </div>

          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '10px' }}>第3层 · 输出层</div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '2px' }}>
              <SwitchRow label="自动回复" checked={autoReply} onClick={() => onTogglePlaceholder('自动回复')} />
              <SwitchRow label="自动外发" checked={autoDispatch} onClick={() => onTogglePlaceholder('自动外发')} />
            </div>
          </div>
        </div>
      </div>

      <div style={{ background: '#fff', border: '1px solid #d7dde7', borderRadius: '12px', padding: '10px 12px', marginBottom: '10px', boxShadow: '0 1px 2px rgba(0,0,0,0.03)' }}>
        <div style={{ fontSize: '15px', fontWeight: 700, marginBottom: '10px' }}>通知通道开关（浏览器真跑，外部通道预留）</div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr 1fr', gap: '10px' }}>
          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <SwitchRow label="浏览器通知" checked={browserNotifyEnabled} onClick={handleBrowserNotifyToggle} />
          </div>

          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <SwitchRow
              label="企业微信占位"
              checked={wecomNotifyEnabled}
              onClick={() => setWecomNotifyEnabled((prev) => !prev)}
            />
          </div>

          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <SwitchRow
              label="微信占位"
              checked={wechatNotifyEnabled}
              onClick={() => setWechatNotifyEnabled((prev) => !prev)}
            />
          </div>

          <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '12px', background: '#fafafa' }}>
            <SwitchRow
              label="钉钉占位"
              checked={dingtalkNotifyEnabled}
              onClick={() => setDingtalkNotifyEnabled((prev) => !prev)}
            />
          </div>
        </div>
      </div>

      <div className="stats-row">
        {stats.map((item) => (
          <div className="mini-card" key={item.label}>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>

      <div className="channel-row">
        {channels.map((name) => (
          <button
            key={name}
            className={`channel ${activeChannel === name ? 'active' : ''}`}
            onClick={() => setActiveChannel(name)}
          >
            {name}
          </button>
        ))}
      </div>

      <div className="main-grid">
        <div className="panel">
          <div className="panel-head">
            <h3>客户总览</h3>
            <p>按固定顺序密集展示，当前优先读取运行时真源</p>
          </div>

          <div className="list-wrap">
            {customers.map((item) => {
              const rowBusiness = businessSnapshot.customers.find((x) => {
                return (x.customer_name || '').trim().toLowerCase() === (item.name || '').trim().toLowerCase()
              })

              return (
                <button
                  key={item.id}
                  className={`list-row ${selectedId === item.id ? 'selected' : ''}`}
                  onClick={() => setSelectedId(item.id)}
                >
                  <div className="list-main">
                    <div className="name-line">
                      <strong>{item.name}</strong>
                      <span className={`tag ${item.category}`}>{item.category}</span>
                    </div>
                    <div className="msg-line">{item.message}</div>

                    {rowBusiness ? (
                      <div style={{ marginTop: '6px', display: 'flex', flexWrap: 'wrap', gap: '4px' }}>
                        <span style={{ borderRadius: '999px', background: '#f3f4f6', padding: '2px 8px', fontSize: '11px', color: '#374151' }}>
                          {getCustomerTypeLabel(rowBusiness.customer_type)}
                        </span>
                        <span style={{ borderRadius: '999px', background: '#f3f4f6', padding: '2px 8px', fontSize: '11px', color: '#374151' }}>
                          {getBusinessStageLabel(rowBusiness.business_stage)}
                        </span>
                        <span style={{ borderRadius: '999px', background: '#f3f4f6', padding: '2px 8px', fontSize: '11px', color: '#374151' }}>
                          {getRiskLevelLabel(rowBusiness.risk_level)}
                        </span>
                      </div>
                    ) : null}
                  </div>

                  <div className="list-side">{item.country}</div>
                  <div className="list-side">{item.channel}</div>
                  <div className="list-side">{item.time}</div>
                </button>
              )
            })}
          </div>
        </div>

        <div className="panel">
          <div className="detail-top">
            <div>
              <h3>{selected.name}</h3>
              <p>{selected.country} · {selected.channel} · {selected.phone}</p>
            </div>

            <div className="keyword-box">
              <div className="keyword-title">判断依据关键词</div>
              <div className="keyword-wrap">
                {currentBusiness && currentBusiness.reason_keywords.length
                  ? currentBusiness.reason_keywords.map((keyword) => (
                      <span className="chip" key={keyword}>{keyword}</span>
                    ))
                  : (selected.keywords || []).map((keyword) => (
                      <span className="chip" key={keyword}>{keyword}</span>
                    ))}
              </div>
            </div>
          </div>

          <div className="detail-card">
            <div className="detail-card-title">业务判断</div>

            {!currentBusiness ? (
              <div style={{ color: '#6b7280' }}>暂无业务判断结果</div>
            ) : (
              <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                  <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
                    <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px' }}>客户类型</div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>{getCustomerTypeLabel(currentBusiness.customer_type)}</div>
                  </div>

                  <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
                    <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px' }}>业务阶段</div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>{getBusinessStageLabel(currentBusiness.business_stage)}</div>
                  </div>

                  <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
                    <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px' }}>风险等级</div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>{getRiskLevelLabel(currentBusiness.risk_level)}</div>
                  </div>

                  <div style={{ border: '1px solid #e5e7eb', borderRadius: '10px', padding: '10px', background: '#fafafa' }}>
                    <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px' }}>人工接管</div>
                    <div style={{ fontSize: '14px', fontWeight: 700 }}>
                      {currentBusiness.handoff_recommended ? '建议人工介入' : '可继续自动跟进'}
                    </div>
                  </div>
                </div>

                <div style={{ borderRadius: '10px', padding: '10px', background: '#eff6ff', border: '1px solid #bfdbfe' }}>
                  <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px' }}>建议下一步</div>
                  <div style={{ fontSize: '14px', fontWeight: 700 }}>{getActionLabel(currentBusiness.next_best_action)}</div>
                </div>

                <div style={{ fontSize: '12px', color: '#6b7280' }}>
                  判断快照时间：{businessSnapshot.updated_at || '—'}
                </div>
              </div>
            )}
          </div>

          <div className="detail-card">
            <div className="detail-card-title">判断说明</div>
            <div>{businessReasonText}</div>
          </div>

          <div className="detail-card">
            <div className="detail-card-title">建议追问</div>
            {currentBusiness && currentBusiness.follow_up_questions.length ? (
              <ul style={{ margin: 0, paddingLeft: '18px' }}>
                {currentBusiness.follow_up_questions.map((question, idx) => (
                  <li key={`${question}-${idx}`} style={{ marginBottom: '8px' }}>{question}</li>
                ))}
              </ul>
            ) : (
              <div style={{ color: '#6b7280' }}>暂无建议追问</div>
            )}
          </div>

          <div className="detail-card">
            <div className="detail-card-title">活跃度提示</div>
            <div style={{ display: 'flex', gap: '12px', alignItems: 'center', flexWrap: 'wrap' }}>
              <span style={{ fontSize: '12px', fontWeight: 700, color: '#d92020' }}>主动问询 {proactiveCount} 次</span>
              <span style={{ fontSize: '12px', fontWeight: 700, color: '#d92020' }}>对话来往 {exchangeCount} 次</span>
              {isHot ? <span style={{ fontSize: '12px', fontWeight: 700, color: '#14a44d' }}>高意向重点跟进</span> : null}
            </div>
          </div>

          <div className="detail-card">
            <div className="detail-card-title">判断时间线</div>
            <ul style={{ margin: 0, paddingLeft: '18px' }}>
              {(selected.timeline || []).map((item, idx) => (
                <li key={`${item}-${idx}`} style={{ marginBottom: '6px' }}>{item}</li>
              ))}
            </ul>
          </div>

          <div className="detail-card">
            <div className="detail-card-title">聊天记录</div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              {(selected.messages || []).map((msg, idx) => (
                <div
                  key={`${msg.role}-${idx}`}
                  style={{
                    padding: '8px 10px',
                    borderRadius: '10px',
                    background: msg.role === '客户' ? '#fff7ed' : '#eff6ff',
                    border: '1px solid #e5e7eb',
                  }}
                >
                  <strong style={{ display: 'block', marginBottom: '4px' }}>{msg.role}</strong>
                  <span>{msg.text}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

function getCounts(messages) {
  const safeMessages = Array.isArray(messages) ? messages : []
  return {
    proactiveCount: safeMessages.filter((msg) => msg.role === '客户').length,
    exchangeCount: safeMessages.length,
  }
}

function getModeLabel(mode) {
  if (mode === 'off') return '关闭'
  if (mode === 'readonly') return '只读观察'
  if (mode === 'manual') return '人工接管'
  return mode || '-'
}

function getCustomerTypeLabel(value) {
  if (value === 'dealer') return '经销商'
  if (value === 'dealer_like') return '疑似经销商'
  if (value === 'retail') return '个人客户'
  if (value === 'unknown') return '待判断'
  return value || '待判断'
}

function getBusinessStageLabel(value) {
  if (value === 'new') return '新线索'
  if (value === 'negotiating') return '洽谈中'
  if (value === 'quoted') return '已报价'
  if (value === 'waiting') return '待回复'
  if (value === 'closed') return '已收口'
  if (value === 'unknown') return '待判断'
  return value || '待判断'
}

function getRiskLevelLabel(value) {
  if (value === 'low') return '低'
  if (value === 'medium') return '中'
  if (value === 'high') return '高'
  if (value === 'unknown') return '待判断'
  return value || '待判断'
}

function getActionLabel(value) {
  if (value === 'human_follow_up') return '建议人工跟进'
  if (value === 'send_quote') return '发送报价'
  if (value === 'ask_requirements') return '继续确认需求'
  if (value === 'pause_and_review') return '暂停并复核'
  if (value === 'unknown') return '待判断'
  return value || '待判断'
}

function buildBusinessReason(currentBusiness) {
  if (!currentBusiness) return '暂无业务判断说明'

  const parts = []
  const customerType = getCustomerTypeLabel(currentBusiness.customer_type)
  const businessStage = getBusinessStageLabel(currentBusiness.business_stage)
  const riskLevel = getRiskLevelLabel(currentBusiness.risk_level)
  const nextAction = getActionLabel(currentBusiness.next_best_action)

  parts.push(`系统判断当前客户更接近“${customerType}”，当前业务阶段为“${businessStage}”，风险等级为“${riskLevel}”。`)

  if (currentBusiness.handoff_recommended) {
    parts.push('当前建议由人工介入跟进，以便更稳地确认采购身份、数量和成交条件。')
  } else {
    parts.push('当前可继续按自动跟进节奏推进。')
  }

  parts.push(`下一步建议为“${nextAction}”。`)

  if (Array.isArray(currentBusiness.reason_keywords) && currentBusiness.reason_keywords.length) {
    parts.push(`判断依据关键词包括：${currentBusiness.reason_keywords.join('、')}。`)
  }

  return parts.join('')
}

function normalizeCustomer(item, index) {
  if (!item || typeof item !== 'object') return null

  return {
    id: String(item.id || item.customer_id || item.phone || index + 1),
    name: item.name || item.customer_name || item.title || item.phone || `客户${index + 1}`,
    category: item.category || item.customer_type || item.segment || item.bucket || '待判断',
    country: item.country || item.destination_country || item.region || '未知',
    channel: item.channel || 'WhatsApp',
    time: item.time || item.last_time || item.updated_at || '—',
    message: item.message || item.last_message || item.summary || item.latest_message || '暂无摘要',
    keywords: Array.isArray(item.keywords) ? item.keywords : [],
    reason: item.reason || item.rationale || item.judgement_reason || '暂无判断说明',
    tags: Array.isArray(item.tags) ? item.tags : [],
    phone: item.phone || item.customer_id || '-',
    timeline: Array.isArray(item.timeline) ? item.timeline : [],
    messages: Array.isArray(item.messages) ? item.messages : [],
  }
}

function normalizeDashboard(data) {
  if (!data || typeof data !== 'object') {
    return { customers: fallbackCustomers, stats: fallbackStats }
  }

  const candidateList =
    data.customers ||
    data.items ||
    data.records ||
    data.conversations ||
    data.list ||
    data.recent_focus ||
    []

  const customers = Array.isArray(candidateList)
    ? candidateList.map(normalizeCustomer).filter(Boolean)
    : fallbackCustomers

  const statsSource = data.stats || data.summary || data.top_stats || {}
  const stats = [
    { label: '准车商', value: statsSource.准车商 || statsSource.ready_dealers || statsSource.readyDealerCount || 0 },
    { label: '疑似车商', value: statsSource.疑似车商 || statsSource.suspected_dealers || statsSource.suspectedDealerCount || 0 },
    { label: '个人客户', value: statsSource.个人客户 || statsSource.individual_customers || statsSource.personalCount || 0 },
    { label: '沟通无效', value: statsSource.沟通无效 || statsSource.无效沟通 || statsSource.invalid_conversations || statsSource.invalidCount || 0 },
  ]

  return {
    customers: customers.length ? customers : fallbackCustomers,
    stats: stats.some((x) => x.value > 0) ? stats : fallbackStats,
  }
}

function normalizeBusinessItem(item) {
  if (!item || typeof item !== 'object') return null

  return {
    customer_name: item.customer_name || item.name || item.customer || 'Unknown',
    customer_type: item.customer_type || 'unknown',
    business_stage: item.business_stage || 'unknown',
    risk_level: item.risk_level || 'unknown',
    next_best_action: item.next_best_action || 'unknown',
    handoff_recommended: Boolean(item.handoff_recommended),
    follow_up_questions: Array.isArray(item.follow_up_questions) ? item.follow_up_questions : [],
    reason_keywords: Array.isArray(item.reason_keywords) ? item.reason_keywords : [],
  }
}

function normalizeBusinessSnapshot(data) {
  if (!data || typeof data !== 'object') {
    return {
      updated_at: '',
      customer_count: 0,
      customers: [],
    }
  }

  const candidateList =
    data.customers ||
    data.items ||
    data.results ||
    []

  const customers = Array.isArray(candidateList)
    ? candidateList.map(normalizeBusinessItem).filter(Boolean)
    : []

  return {
    updated_at: data.updated_at || '',
    customer_count: data.customer_count || customers.length || 0,
    customers,
  }
}


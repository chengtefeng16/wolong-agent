class ExecutionManager:
    def _build_delivery_payload(self, formatted_output):
        formatted_output = formatted_output or {}
        channel_delivery = formatted_output.get("channel_delivery") or {}
        customer_text = formatted_output.get("customer_facing_text") or ""
        internal_text = formatted_output.get("internal_review_text") or ""

        if not channel_delivery:
            channel_delivery = {
                "channel_type": "customer_channel",
                "send_text": customer_text,
                "internal_visible_text": internal_text,
                "external_text_only": True,
            }

        return {
            "channel_type": channel_delivery.get("channel_type"),
            "send_text": channel_delivery.get("send_text", ""),
            "internal_visible_text": channel_delivery.get("internal_visible_text", ""),
            "external_text_only": channel_delivery.get("external_text_only", True),
        }

    def _build_delivery_gate(self, formatted_output):
        formatted_output = formatted_output or {}
        human_review_gate = formatted_output.get("human_review_gate", {}) or {}

        outbound_ready = bool(formatted_output.get("outbound_ready", False))
        block_reason = formatted_output.get("outbound_block_reason")
        human_review_required = bool(human_review_gate.get("required", False))

        if human_review_required and not block_reason:
            block_reason = human_review_gate.get("reason") or "human_review_required"

        return {
            "outbound_ready": outbound_ready,
            "human_review_required": human_review_required,
            "block_reason": block_reason,
            "gate_status": human_review_gate.get("status"),
        }

    def _build_delegation_policy(self, formatted_output):
        formatted_output = formatted_output or {}
        delegation_policy = formatted_output.get("delegation_policy", {}) or {}

        if not delegation_policy:
            delegation_policy = {
                "delegation_enabled": False,
                "delegation_stage": "manual_review_first",
                "permission_level": "L0_disabled",
                "allowed_time_windows": [],
                "allowed_channels": [],
                "allowed_actions": [],
                "risk_levels_allowed": ["low"],
                "business_stages_allowed": [],
                "customer_scope": {"mode": "limited"},
                "human_supervision_mode": "human_review_required",
                "max_auto_send_per_window": 0,
                "fallback_to_human_on_risk": True,
                "audit_required": True,
                "rollback_enabled": True,
                "manual_review_required": True,
                "policy_reason": "default_safe_policy",
                "policy_summary": "default safe policy",
                "business_stage": None,
                "next_action": None,
                "risk_level": None,
                "time_control": {
                    "enabled": False,
                    "allowed_time_windows": [],
                    "timezone": "Asia/Shanghai",
                    "mode": "multi_window",
                },
                "channel_control": {
                    "enabled": False,
                    "allowed_channels": [],
                    "mode": "multi_select",
                },
                "action_control": {
                    "enabled": False,
                    "allowed_actions": [],
                    "mode": "multi_select",
                    "customer_send_enabled": False,
                },
                "risk_control": {
                    "enabled": False,
                    "risk_levels_allowed": ["low"],
                    "mode": "multi_select",
                },
                "business_stage_control": {
                    "enabled": False,
                    "business_stages_allowed": [],
                    "mode": "multi_select",
                },
                "supervision_control": {
                    "human_supervision_mode": "human_review_required",
                    "manual_review_required": True,
                    "fallback_to_human_on_risk": True,
                },
            }

        return {
            "delegation_enabled": bool(delegation_policy.get("delegation_enabled", False)),
            "delegation_stage": delegation_policy.get("delegation_stage", "manual_review_first"),
            "delegation_master_switch": bool(delegation_policy.get("delegation_master_switch", False)),
            "permission_level": delegation_policy.get("permission_level", "L0_disabled"),

            "allowed_time_windows": list(delegation_policy.get("allowed_time_windows", []) or []),
            "allowed_channels": list(delegation_policy.get("allowed_channels", []) or []),
            "allowed_actions": list(delegation_policy.get("allowed_actions", []) or []),
            "risk_levels_allowed": list(delegation_policy.get("risk_levels_allowed", ["low"]) or ["low"]),
            "business_stages_allowed": list(delegation_policy.get("business_stages_allowed", []) or []),

            "customer_scope": dict(delegation_policy.get("customer_scope", {}) or {}),
            "human_supervision_mode": delegation_policy.get("human_supervision_mode", "human_review_required"),
            "max_auto_send_per_window": int(delegation_policy.get("max_auto_send_per_window", 0) or 0),
            "fallback_to_human_on_risk": bool(delegation_policy.get("fallback_to_human_on_risk", True)),
            "audit_required": bool(delegation_policy.get("audit_required", True)),
            "rollback_enabled": bool(delegation_policy.get("rollback_enabled", True)),
            "manual_review_required": bool(delegation_policy.get("manual_review_required", False)),
            "policy_reason": delegation_policy.get("policy_reason"),
            "policy_summary": delegation_policy.get("policy_summary"),
            "business_stage": delegation_policy.get("business_stage"),
            "next_action": delegation_policy.get("next_action"),
            "risk_level": delegation_policy.get("risk_level"),
            "destination_country": delegation_policy.get("destination_country"),

            "time_control": dict(delegation_policy.get("time_control", {}) or {}),
            "channel_control": dict(delegation_policy.get("channel_control", {}) or {}),
            "action_control": dict(delegation_policy.get("action_control", {}) or {}),
            "risk_control": dict(delegation_policy.get("risk_control", {}) or {}),
            "business_stage_control": dict(delegation_policy.get("business_stage_control", {}) or {}),
            "supervision_control": dict(delegation_policy.get("supervision_control", {}) or {}),
            "quota_control": dict(delegation_policy.get("quota_control", {}) or {}),
            "exception_control": dict(delegation_policy.get("exception_control", {}) or {}),
            "audit_control": dict(delegation_policy.get("audit_control", {}) or {}),
            "configurable_fields": dict(delegation_policy.get("configurable_fields", {}) or {}),
            "l1_whitelist_candidate": bool(delegation_policy.get("l1_whitelist_candidate", False)),
        }

    def _is_time_window_allowed(self, allowed_time_windows):
        windows = list(allowed_time_windows or [])
        if not windows:
            return True
        return "always" in windows or "08:00-20:00" in windows

    def _resolve_time_windows(self, delegation_policy):
        time_control = delegation_policy.get("time_control", {}) or {}
        if time_control.get("enabled"):
            grouped = list(time_control.get("allowed_time_windows", []) or [])
            if grouped:
                return grouped
        return list(delegation_policy.get("allowed_time_windows", []) or [])

    def _resolve_allowed_channels(self, delegation_policy):
        channel_control = delegation_policy.get("channel_control", {}) or {}
        if channel_control.get("enabled"):
            grouped = list(channel_control.get("allowed_channels", []) or [])
            if grouped:
                return grouped
        return list(delegation_policy.get("allowed_channels", []) or [])

    def _resolve_allowed_actions(self, delegation_policy):
        action_control = delegation_policy.get("action_control", {}) or {}
        actions = []
        if action_control.get("enabled"):
            actions = list(action_control.get("allowed_actions", []) or [])
        if not actions:
            actions = list(delegation_policy.get("allowed_actions", []) or [])
        if action_control.get("customer_send_enabled") and "customer_send" not in actions:
            actions.append("customer_send")
        return actions

    def _resolve_risk_levels_allowed(self, delegation_policy):
        risk_control = delegation_policy.get("risk_control", {}) or {}
        if risk_control.get("enabled"):
            grouped = list(risk_control.get("risk_levels_allowed", []) or [])
            if grouped:
                return grouped
        return list(delegation_policy.get("risk_levels_allowed", []) or [])

    def _resolve_business_stages_allowed(self, delegation_policy):
        stage_control = delegation_policy.get("business_stage_control", {}) or {}
        if stage_control.get("enabled"):
            grouped = list(stage_control.get("business_stages_allowed", []) or [])
            if grouped:
                return grouped
        return list(delegation_policy.get("business_stages_allowed", []) or [])

    def _resolve_manual_review_required(self, delivery_gate, delegation_policy):
        supervision = delegation_policy.get("supervision_control", {}) or {}
        if supervision.get("manual_review_required") is True:
            return True
        return bool(
            delivery_gate.get("human_review_required")
            or delegation_policy.get("manual_review_required")
        )

    def _evaluate_delegation_decision(self, delivery_gate, delegation_policy, formatted_output):
        formatted_output = formatted_output or {}
        target_source = str(formatted_output.get("target_source") or "").strip().lower()
        risk_level = delegation_policy.get("risk_level")
        business_stage = delegation_policy.get("business_stage")

        manual_review_required = self._resolve_manual_review_required(delivery_gate, delegation_policy)
        if manual_review_required:
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "manual_review_required",
                "priority_level": "human_review_gate",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        if not delivery_gate.get("outbound_ready", False):
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": delivery_gate.get("block_reason") or "outbound_not_ready",
                "priority_level": "output_gate",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        if not delegation_policy.get("delegation_master_switch", delegation_policy.get("delegation_enabled", False)):
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "delegation_master_switch_off",
                "priority_level": "master_switch",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        if not delegation_policy.get("delegation_enabled", False):
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "delegation_disabled",
                "priority_level": "delegation_enable_flag",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        permission_level = delegation_policy.get("permission_level")
        permission_control = delegation_policy.get("permission_control", {}) or {}
        customer_send_allowed_levels = list(permission_control.get("customer_send_allowed_levels", []) or [])
        if customer_send_allowed_levels and permission_level not in customer_send_allowed_levels:
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "permission_level_not_allowed_for_customer_send",
                "priority_level": "permission_level",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        allowed_time_windows = self._resolve_time_windows(delegation_policy)
        if not self._is_time_window_allowed(allowed_time_windows):
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "time_window_not_allowed",
                "priority_level": "time_window",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        allowed_actions = self._resolve_allowed_actions(delegation_policy)
        if "customer_send" not in allowed_actions:
            reason = "action_not_allowed"
            if delegation_policy.get("l1_whitelist_candidate"):
                reason = "l1_candidate_but_send_not_enabled"
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": reason,
                "priority_level": "action_control",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        allowed_channels = self._resolve_allowed_channels(delegation_policy)
        if allowed_channels and target_source not in allowed_channels:
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "channel_not_allowed",
                "priority_level": "channel_control",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        risk_levels_allowed = self._resolve_risk_levels_allowed(delegation_policy)
        if risk_level and risk_levels_allowed and risk_level not in risk_levels_allowed:
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "risk_level_not_allowed",
                "priority_level": "risk_control",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        business_stages_allowed = self._resolve_business_stages_allowed(delegation_policy)
        if business_stage and business_stages_allowed and business_stage not in business_stages_allowed:
            return {
                "allow_real_send": False,
                "decision": "blocked",
                "reason": "business_stage_not_allowed",
                "priority_level": "business_stage_control",
                "checked_channel": target_source,
                "checked_action": "customer_send",
                "checked_risk_level": risk_level,
                "checked_business_stage": business_stage,
            }

        return {
            "allow_real_send": True,
            "decision": "allowed",
            "reason": "delegation_policy_passed",
            "priority_level": "passed",
            "checked_channel": target_source,
            "checked_action": "customer_send",
            "checked_risk_level": risk_level,
            "checked_business_stage": business_stage,
        }
    def attach_delivery_payload(self, execution_task, formatted_output):
        execution_task = dict(execution_task or {})
        delivery_payload = self._build_delivery_payload(formatted_output)
        delivery_gate = self._build_delivery_gate(formatted_output)
        delegation_policy = self._build_delegation_policy(formatted_output)
        delegation_decision = self._evaluate_delegation_decision(
            delivery_gate=delivery_gate,
            delegation_policy=delegation_policy,
            formatted_output=formatted_output,
        )

        execution_task["delivery_payload"] = delivery_payload
        execution_task["delivery_gate"] = delivery_gate
        execution_task["delegation_policy"] = delegation_policy
        execution_task["delegation_decision"] = delegation_decision

        steps = execution_task.get("execution_steps", []) or []
        for step in steps:
            executor = step.get("executor")
            action = step.get("action")

            if executor in ("api", "browser", "desktop"):
                step["delivery_payload"] = dict(delivery_payload)
                step["delivery_gate"] = dict(delivery_gate)
                step["delegation_policy"] = dict(delegation_policy)
                step["delegation_decision"] = dict(delegation_decision)

            if executor == "desktop" and action == "type_text":
                step.setdefault("payload", {})
                step["payload"]["text"] = delivery_payload.get("send_text", "")

            if executor == "api":
                step.setdefault("payload", {})
                step["payload"]["delivery_mode"] = "channel_delivery"
                step["payload"]["send_text"] = delivery_payload.get("send_text", "")
                step["payload"]["external_text_only"] = delivery_payload.get("external_text_only", True)

            if executor == "browser":
                step.setdefault("payload", {})
                step["payload"]["delivery_mode"] = "channel_delivery"
                step["payload"]["send_text"] = delivery_payload.get("send_text", "")
                step["payload"]["external_text_only"] = delivery_payload.get("external_text_only", True)

        execution_task["execution_steps"] = steps
        return execution_task

    def inject_delivery_payload(self, execution_task, formatted_output):
        return self.attach_delivery_payload(execution_task, formatted_output)


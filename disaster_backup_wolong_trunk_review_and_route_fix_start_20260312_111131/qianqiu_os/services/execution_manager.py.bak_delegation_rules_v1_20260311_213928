                },
            ],
        }

    def simulate_execution(self, execution_task):
        execution_task = dict(execution_task or {})
        delivery_payload = dict(execution_task.get("delivery_payload") or {})
        delivery_gate = dict(execution_task.get("delivery_gate") or {})
        delegation_policy = dict(execution_task.get("delegation_policy") or {})

        outbound_ready = bool(delivery_gate.get("outbound_ready", False))
        human_review_required = bool(delivery_gate.get("human_review_required", False))
        gate_block_reason = delivery_gate.get("block_reason")

        delegation_enabled = bool(delegation_policy.get("delegation_enabled", False))
        allowed_actions = list(delegation_policy.get("allowed_actions", []) or [])
        delegation_allows_real_send = delegation_enabled and ("customer_send" in allowed_actions)
        delegation_block_reason = None if delegation_allows_real_send else "delegation_policy_denied"

        send_blocked_by_gate = (not outbound_ready) or human_review_required
        send_blocked_by_delegation = not delegation_allows_real_send
        real_send_blocked = send_blocked_by_gate or send_blocked_by_delegation

        final_block_reason = gate_block_reason if send_blocked_by_gate else delegation_block_reason

        logs = []
        failed_steps = []

        api_send_executed = False
        browser_send_executed = False
        desktop_send_executed = False

        for step in execution_task.get("execution_steps", []) or []:
            step["status"] = "done"
            executor = step.get("executor")
            action = step.get("action")
            payload = step.get("payload", {})

            if executor in ("system", "tool"):
                msg = f"执行层完成动作模拟：{action}"
                logs.append({
                    "step": step.get("step"),
                    "action": action,
                    "executor": executor,
                    "message": msg,
                })
                continue

            if executor in ("api", "browser", "desktop"):
                delivery_for_step = dict(step.get("delivery_payload") or delivery_payload)
                gate_for_step = dict(step.get("delivery_gate") or delivery_gate)
                delegation_for_step = dict(step.get("delegation_policy") or delegation_policy)

                if real_send_blocked:
                    msg = f"{executor} 执行器已被治理策略拦截：{action}"
                    exec_status = "blocked"
                    real_send_executed = False
                else:
                    msg = f"{executor} 执行器已接收动作：{action}"
                    exec_status = "simulated_success"
                    real_send_executed = True

                log_item = {
                    "step": step.get("step"),
                    "action": action,
                    "executor": executor,
                    "message": msg,
                    "executor_result": {
                        "executor": f"{executor}_executor_v2",
                        "action_name": action,
                        "action_payload": payload,
                        "execution_status": exec_status,
                        "real_send_executed": real_send_executed,
                        "block_reason": final_block_reason,
                        "message": msg,
                    },
                    "delivery_payload": delivery_for_step,
                    "delivery_gate": gate_for_step,
                    "delegation_policy": delegation_for_step,
                }
                logs.append(log_item)

                if executor == "api":
                    api_send_executed = real_send_executed
                elif executor == "browser":
                    browser_send_executed = real_send_executed
                elif executor == "desktop" and action == "type_text":
                    desktop_send_executed = real_send_executed

        execution_task["execution_status"] = "done"

        return {
            "api_delivery_payload": dict(delivery_payload),
            "browser_delivery_payload": dict(delivery_payload),
            "desktop_delivery_payload": dict(delivery_payload),
            "delivery_gate": dict(delivery_gate),
            "delegation_policy": dict(delegation_policy),
            "delegation_enabled": delegation_enabled,
            "delegation_allows_real_send": delegation_allows_real_send,
            "send_blocked_by_gate": send_blocked_by_gate,
            "send_blocked_by_delegation": send_blocked_by_delegation,
            "block_reason": final_block_reason,
            "outbound_ready": outbound_ready,
            "human_review_required": human_review_required,
            "api_send_executed": api_send_executed,
            "browser_send_executed": browser_send_executed,
            "desktop_send_executed": desktop_send_executed,
            "execution_status": "done",
            "executed_step_count": len(execution_task.get("execution_steps", []) or []),
            "failed_step_count": len(failed_steps),
            "failed_steps": failed_steps,
            "execution_logs": logs,
            "control_flags": execution_task.get("control_flags", {}),
        }

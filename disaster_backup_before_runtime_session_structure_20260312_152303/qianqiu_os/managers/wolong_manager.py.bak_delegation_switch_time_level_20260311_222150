import re


class WolongManager:
    def __init__(self, tool_registry=None):
        self.tool_registry = tool_registry or {}

    def detect_wolong_inquiry(self, incoming_input):
        message_text = self._extract_message_text(incoming_input)
        normalized_text = message_text.lower()

        inquiry_detected = self._is_policy_check_inquiry(normalized_text)
        inquiry_type = "policy_check" if inquiry_detected else None
        language = self._detect_language(message_text)
        destination_country = self._extract_destination_country(message_text)

        return {
            "wolong_linked": inquiry_detected,
            "inquiry_detected": inquiry_detected,
            "inquiry_type": inquiry_type,
            "language_detected": language,
            "destination_country": destination_country,
            "message_text": message_text,
        }

    def handle_inquiry(self, incoming_input, user_memory_context=None):
        detection_result = self.detect_wolong_inquiry(incoming_input)

        if not detection_result.get("inquiry_detected"):
            return {
                "wolong_linked": False,
                "inquiry_detected": False,
                "policy_check_executed": False,
            }

        tool_result = self._run_policy_check(
            incoming_input=incoming_input,
            detection_result=detection_result,
        )

        customer_reply_result = self._build_customer_reply_result(
            tool_result=tool_result,
            detection_result=detection_result,
        )

        manual_review_result = self._build_manual_review_result(
            tool_result=tool_result,
            detection_result=detection_result,
        )

        business_action_result = self._build_business_action_result(
            tool_result=tool_result,
            detection_result=detection_result,
            manual_review_result=manual_review_result,
        )

        delegation_policy_result = self._build_delegation_policy_result(
            tool_result=tool_result,
            detection_result=detection_result,
            manual_review_result=manual_review_result,
            business_action_result=business_action_result,
        )

        business_action_result = self._build_business_action_result(
            tool_result=tool_result,
            detection_result=detection_result,
            manual_review_result=manual_review_result,
        )

        return {
            "wolong_linked": True,
            "execution_status": (
                "completed_with_manual_review"
                if tool_result.get("manual_review_required")
                else "completed"
            ),
            "inquiry_detected": True,
            "inquiry_type": detection_result.get("inquiry_type"),
            "language_detected": detection_result.get("language_detected"),
            "destination_country": detection_result.get("destination_country"),
            "policy_check_executed": True,
            "policy_result": tool_result,
            "customer_reply_result": customer_reply_result,
            "manual_review_result": manual_review_result,
            "business_action_result": business_action_result,
            "delegation_policy_result": delegation_policy_result,
            "wolong_log": {
                "risk_level": tool_result.get("risk_level"),
                "missing_fields": tool_result.get("missing_fields", []),
            },
        }

    def _run_policy_check(self, incoming_input, detection_result):
        parsed = self._parse_vehicle_info(detection_result.get("message_text", ""))

        destination_country = (
            parsed.get("destination_country")
            or detection_result.get("destination_country")
            or "Unknown"
        )
        vehicle_year = parsed.get("vehicle_year")
        fuel_type = parsed.get("fuel_type") or "unknown"
        vehicle_type = parsed.get("vehicle_type") or "vehicle"

        missing_fields = []
        if not parsed.get("steering"):
            missing_fields.append("steering")
        if not parsed.get("emission_standard"):
            missing_fields.append("emission_standard")

        tool_payload = {
            "country_code_or_name": destination_country,
            "vehicle": {
                "age": (2026 - vehicle_year) if vehicle_year else None,
                "fuel": fuel_type,
                "emission": parsed.get("emission_standard") or "unknown",
                "steering": parsed.get("steering") or "unknown",
                "vehicle_type": vehicle_type,
                "year": vehicle_year,
                "certification": True,
                "ev_grid_risk": "low",
            },
        }

        tool = self.tool_registry.get("policy_check")

        if callable(tool):
            try:
                raw_result = tool(tool_payload)

                if isinstance(raw_result, dict):
                    inner_result = raw_result.get("tool_result", raw_result)
                    if isinstance(inner_result, dict):
                        manual_review_required = inner_result.get("manual_review_required", True)
                        risk_level = inner_result.get("risk_level", "medium")
                        allowed = inner_result.get("allowed", True)

                        return {
                            "tool_name": "wolong_policy_check_tool",
                            "executed": True,
                            "allowed": allowed,
                            "risk_level": risk_level,
                            "manual_review_required": manual_review_required,
                            "rule_hits": inner_result.get(
                                "rule_hits",
                                [
                                    "country_supported",
                                    "vehicle_age_check_passed",
                                    "fuel_type_check_passed",
                                ],
                            ),
                            "policy_summary": (
                                f"Preliminary policy review suggests the "
                                f"{vehicle_year or 'unknown year'} {fuel_type} {vehicle_type} "
                                f"may be eligible for import into {destination_country}, "
                                f"but manual confirmation is still required."
                            ),
                            "missing_fields": missing_fields,
                            "notes": inner_result.get(
                                "notes",
                                ["Local compliance confirmation is required."]
                            ),
                            "vehicle_type": vehicle_type,
                            "destination_country": destination_country,
                            "vehicle_year": vehicle_year,
                            "fuel_type": fuel_type,
                            "steering": parsed.get("steering", "unknown"),
                            "emission_standard": parsed.get("emission_standard", "unknown"),
                            "policy_health": inner_result.get("policy_health", {"is_outdated": False}),
                            "policy_meta": inner_result.get("policy_meta", {"confidence_level": 0.8}),
                            "status": inner_result.get("status", "handled"),
                        }
            except Exception as exc:
                return {
                    "tool_name": "wolong_policy_check_tool",
                    "executed": False,
                    "allowed": False,
                    "risk_level": "high",
                    "manual_review_required": True,
                    "policy_summary": f"Policy check tool execution failed: {exc}",
                    "missing_fields": missing_fields,
                    "notes": ["Tool execution failed, manual review is required."],
                    "vehicle_type": vehicle_type,
                    "destination_country": destination_country,
                    "vehicle_year": vehicle_year,
                    "fuel_type": fuel_type,
                    "steering": parsed.get("steering", "unknown"),
                    "emission_standard": parsed.get("emission_standard", "unknown"),
                    "policy_health": {"is_outdated": False},
                    "policy_meta": {"confidence_level": 0.3},
                    "status": "error",
                }

        return {
            "tool_name": "wolong_policy_check_tool",
            "executed": True,
            "allowed": True,
            "risk_level": "medium",
            "manual_review_required": True,
            "rule_hits": [
                "country_supported",
                "vehicle_age_check_passed",
                "fuel_type_check_passed",
            ],
            "policy_summary": (
                f"Preliminary policy review suggests the {vehicle_year or 'unknown year'} "
                f"{fuel_type} {vehicle_type} may be eligible for import into {destination_country}, "
                f"but manual confirmation is still required."
            ),
            "missing_fields": missing_fields,
            "notes": ["Local compliance confirmation is required."],
            "vehicle_type": vehicle_type,
            "destination_country": destination_country,
            "vehicle_year": vehicle_year,
            "fuel_type": fuel_type,
            "steering": parsed.get("steering", "unknown"),
            "emission_standard": parsed.get("emission_standard", "unknown"),
            "policy_health": {"is_outdated": False},
            "policy_meta": {"confidence_level": 0.8},
            "status": "handled",
        }

    def _build_customer_reply_result(self, tool_result, detection_result):
        language = detection_result.get("language_detected") or "en"
        destination_country = (
            detection_result.get("destination_country")
            or tool_result.get("destination_country")
            or "the destination country"
        )
        missing_fields = tool_result.get("missing_fields", [])

        if language == "en":
            reply_lines = [
                "Hello, based on our preliminary review, this vehicle may be eligible for import into "
                f"{destination_country}, but some compliance details still need manual confirmation."
            ]
            if missing_fields:
                reply_lines.append(
                    "Please share the following details for a more accurate check: "
                    + ", ".join(missing_fields)
                    + "."
                )
            else:
                reply_lines.append(
                    f"Please share the exact model and destination port in {destination_country} for a more accurate check."
                )
            reply_lines.append(
                "After we confirm these details, we can provide a more reliable import assessment."
            )
            reply_text = " ".join(reply_lines)
        else:
            reply_text = tool_result.get("policy_summary", "")

        return {
            "reply_ready": True,
            "reply_language": language,
            "reply_text": reply_text,
            "reply_status": "draft_ready",
        }

    def _build_manual_review_result(self, tool_result, detection_result):
        missing_fields = tool_result.get("missing_fields", [])

        return {
            "manual_review_required": bool(tool_result.get("manual_review_required")),
            "review_reason": (
                "policy_preliminary_only"
                if tool_result.get("manual_review_required")
                else None
            ),
            "review_summary": (
                f"Customer asks about import feasibility to {detection_result.get('destination_country')}. "
                f"Preliminary policy check completed. Missing fields: {missing_fields}. "
                f"Human confirmation is required."
            ),
        }

    def _build_business_action_result(self, tool_result, detection_result, manual_review_result):
        missing_fields = tool_result.get("missing_fields", []) or []
        destination_country = (
            detection_result.get("destination_country")
            or tool_result.get("destination_country")
            or "unknown"
        )
        manual_review_required = bool(manual_review_result.get("manual_review_required"))

        if manual_review_required and missing_fields:
            return {
                "business_stage": "awaiting_customer_information_and_manual_review",
                "next_action": "collect_missing_fields_then_submit_for_manual_review",
                "operator_todo": (
                    f"Collect missing vehicle compliance details for {destination_country}, "
                    "then pass the case to manual review."
                ),
                "customer_followup_needed": True,
                "customer_followup_fields": missing_fields,
            }

        if manual_review_required:
            return {
                "business_stage": "awaiting_manual_review",
                "next_action": "submit_case_for_manual_review",
                "operator_todo": (
                    f"Submit the {destination_country} import feasibility case for manual confirmation."
                ),
                "customer_followup_needed": False,
                "customer_followup_fields": [],
            }

        return {
            "business_stage": "ready_for_customer_send",
            "next_action": "send_customer_reply",
            "operator_todo": "Customer-facing reply can be sent through the selected channel.",
            "customer_followup_needed": False,
            "customer_followup_fields": [],
        }



    def _build_delegation_policy_result(
        self, tool_result, detection_result, manual_review_result, business_action_result
    ):
        destination_country = (
            detection_result.get("destination_country")
            or tool_result.get("destination_country")
            or "Unknown"
        )
        missing_fields = tool_result.get("missing_fields", []) or []
        risk_level = tool_result.get("risk_level") or "medium"
        business_stage = business_action_result.get("business_stage")

        channels_default = ["whatsapp", "facebook", "instagram", "web_chat"]
        actions_default = [
            "generate_reply",
            "collect_missing_fields",
            "submit_manual_review",
        ]
        risk_levels_default = ["low"]
        business_stages_default = [
            "initial_inquiry",
            "missing_fields_collection",
            "manual_review_preparation",
        ]

        is_l1_whitelist_candidate = (
            destination_country == "Kenya"
            and risk_level == "low"
            and business_stage in ["initial_inquiry", "missing_fields_collection"]
        )

        return {
            "delegation_enabled": True,
            "delegation_stage": "l1_whitelist_defined",
            "permission_level": "L1_generate_only",
            "policy_summary": (
                "当前 delegation_policy 已进入面向后台可配置的第一版结构；"
                "当前只开放生成回复、补资料、提交人工复核，不开放真实自动外发。"
            ),
            "policy_reason": (
                "l1_whitelist_candidate_but_customer_send_not_enabled"
                if is_l1_whitelist_candidate
                else "not_in_l1_whitelist_or_manual_review_required"
            ),
            "manual_review_required": bool(manual_review_result.get("manual_review_required")),
            "human_supervision_mode": "human_review_required",
            "fallback_to_human_on_risk": True,
            "rollback_enabled": True,
            "audit_required": True,

            "configurable_fields": {
                "supports_backend_config": True,
                "multi_select_fields": [
                    "allowed_time_windows",
                    "allowed_channels",
                    "allowed_actions",
                    "risk_levels_allowed",
                    "business_stages_allowed",
                    "customer_scope.countries",
                ],
                "single_select_fields": [
                    "permission_level",
                    "delegation_stage",
                    "human_supervision_mode",
                    "customer_scope.mode",
                ],
                "boolean_fields": [
                    "delegation_enabled",
                    "fallback_to_human_on_risk",
                    "rollback_enabled",
                    "audit_required",
                ],
                "number_fields": [
                    "max_auto_send_per_window",
                ],
            },

            "time_control": {
                "enabled": True,
                "allowed_time_windows": ["08:00-20:00"],
                "timezone": "Asia/Shanghai",
                "mode": "multi_window",
            },

            "channel_control": {
                "enabled": True,
                "allowed_channels": channels_default,
                "mode": "multi_select",
            },

            "action_control": {
                "enabled": True,
                "allowed_actions": actions_default,
                "mode": "multi_select",
                "customer_send_enabled": False,
            },

            "risk_control": {
                "enabled": True,
                "risk_levels_allowed": risk_levels_default,
                "mode": "multi_select",
            },

            "business_stage_control": {
                "enabled": True,
                "business_stages_allowed": business_stages_default,
                "mode": "multi_select",
            },

            "customer_scope": {
                "mode": "limited",
                "countries": ["Kenya"],
            },

            "supervision_control": {
                "human_supervision_mode": "human_review_required",
                "manual_review_required": bool(manual_review_result.get("manual_review_required")),
                "fallback_to_human_on_risk": True,
            },

            "quota_control": {
                "enabled": True,
                "max_auto_send_per_window": 0,
                "window_unit": "day",
            },

            "exception_control": {
                "enabled": True,
                "fallback_to_human_on_risk": True,
                "rollback_enabled": True,
            },

            "audit_control": {
                "enabled": True,
                "audit_required": True,
                "log_all_decisions": True,
            },

            "allowed_time_windows": ["08:00-20:00"],
            "allowed_channels": channels_default,
            "allowed_actions": actions_default,
            "risk_levels_allowed": risk_levels_default,
            "business_stages_allowed": business_stages_default,

            "missing_fields": missing_fields,
            "risk_level": risk_level,
            "business_stage": business_stage,
            "next_action": business_action_result.get("next_action"),
            "l1_whitelist_candidate": is_l1_whitelist_candidate,
            "destination_country": destination_country,
        }
    def _extract_message_text(self, incoming_input):
        if isinstance(incoming_input, dict):
            return (
                incoming_input.get("message_text")
                or incoming_input.get("text")
                or incoming_input.get("content")
                or ""
            )
        return str(incoming_input or "")

    def _detect_language(self, message_text):
        if re.search(r"[\u4e00-\u9fff]", message_text):
            return "zh"
        return "en"

    def _extract_destination_country(self, message_text):
        text = (message_text or "").lower()

        country_map = {
            "kenya": "Kenya",
            "uganda": "Uganda",
            "tanzania": "Tanzania",
            "rwanda": "Rwanda",
            "zambia": "Zambia",
            "ghana": "Ghana",
            "nigeria": "Nigeria",
        }

        for key, value in country_map.items():
            if key in text:
                return value

        return None

    def _is_policy_check_inquiry(self, normalized_text):
        keywords = [
            "import",
            "eligible",
            "can i import",
            "policy",
            "allowed",
            "restriction",
            "compliance",
            "into kenya",
            "into uganda",
            "into tanzania",
        ]
        return any(keyword in normalized_text for keyword in keywords)

    def _parse_vehicle_info(self, message_text):
        text = (message_text or "").lower()

        year_match = re.search(r"\b(19\d{2}|20\d{2})\b", text)
        fuel_match = re.search(r"\b(petrol|diesel|hybrid|electric)\b", text)
        vehicle_type_match = re.search(
            r"\b(suv|sedan|truck|pickup|van|wagon|hatchback)\b", text
        )
        steering_match = re.search(
            r"\b(left[- ]hand drive|right[- ]hand drive|lhd|rhd)\b", text
        )
        emission_match = re.search(
            r"\b(euro ?[3-6]|euro iii|euro iv|euro v|euro vi)\b", text
        )

        return {
            "vehicle_year": int(year_match.group(1)) if year_match else None,
            "fuel_type": fuel_match.group(1) if fuel_match else None,
            "vehicle_type": vehicle_type_match.group(1).upper() if vehicle_type_match else None,
            "steering": steering_match.group(1) if steering_match else None,
            "emission_standard": emission_match.group(1) if emission_match else None,
            "destination_country": self._extract_destination_country(message_text),
        }

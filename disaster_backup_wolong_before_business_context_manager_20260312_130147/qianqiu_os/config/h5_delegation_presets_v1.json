{
  "preset_name": "h5_delegation_presets_v1",
  "version": "2026-03-12",
  "description": "H5 delegation presets for Wolong AgentOS",
  "presets": [
    {
      "key": "L3_small_autonomy_safe",
      "label": "L3 小放权安全样例",
      "delegation_policy": {
        "delegation_master_switch": true,
        "delegation_enabled": true,
        "delegation_stage": "L3_small_autonomy",
        "permission_level": "L3",

        "allowed_time_windows": ["always"],
        "allowed_channels": ["wechat", "email"],
        "allowed_actions": ["customer_send"],
        "risk_levels_allowed": ["low"],
        "business_stages_allowed": ["lead", "contacted", "negotiating"],

        "manual_review_required": false,
        "human_supervision_mode": "delegated_with_audit",
        "fallback_to_human_on_risk": true,
        "audit_required": true,
        "rollback_enabled": true,

        "time_control": {
          "enabled": true,
          "allowed_time_windows": ["always"],
          "timezone": "Asia/Shanghai",
          "mode": "multi_window"
        },
        "channel_control": {
          "enabled": true,
          "allowed_channels": ["wechat", "email"],
          "mode": "multi_select"
        },
        "action_control": {
          "enabled": true,
          "allowed_actions": ["customer_send"],
          "mode": "multi_select",
          "customer_send_enabled": true
        },
        "risk_control": {
          "enabled": true,
          "risk_levels_allowed": ["low"],
          "mode": "multi_select"
        },
        "business_stage_control": {
          "enabled": true,
          "business_stages_allowed": ["lead", "contacted", "negotiating"],
          "mode": "multi_select"
        },
        "permission_control": {
          "customer_send_allowed_levels": ["L3", "L4", "L5"]
        },
        "supervision_control": {
          "human_supervision_mode": "delegated_with_audit",
          "manual_review_required": false,
          "fallback_to_human_on_risk": true
        }
      }
    },
    {
      "key": "L4_full_auto_send_safe",
      "label": "L4 更高放权样例",
      "delegation_policy": {
        "delegation_master_switch": true,
        "delegation_enabled": true,
        "delegation_stage": "L4_full_auto_send",
        "permission_level": "L4",

        "allowed_time_windows": ["always"],
        "allowed_channels": ["wechat", "email"],
        "allowed_actions": ["customer_send"],
        "risk_levels_allowed": ["low", "medium"],
        "business_stages_allowed": ["lead", "contacted", "negotiating", "quoted", "follow_up"],

        "manual_review_required": false,
        "human_supervision_mode": "delegated_with_audit",
        "fallback_to_human_on_risk": true,
        "audit_required": true,
        "rollback_enabled": true,

        "time_control": {
          "enabled": true,
          "allowed_time_windows": ["always"],
          "timezone": "Asia/Shanghai",
          "mode": "multi_window"
        },
        "channel_control": {
          "enabled": true,
          "allowed_channels": ["wechat", "email"],
          "mode": "multi_select"
        },
        "action_control": {
          "enabled": true,
          "allowed_actions": ["customer_send"],
          "mode": "multi_select",
          "customer_send_enabled": true
        },
        "risk_control": {
          "enabled": true,
          "risk_levels_allowed": ["low", "medium"],
          "mode": "multi_select"
        },
        "business_stage_control": {
          "enabled": true,
          "business_stages_allowed": ["lead", "contacted", "negotiating", "quoted", "follow_up"],
          "mode": "multi_select"
        },
        "permission_control": {
          "customer_send_allowed_levels": ["L4", "L5"]
        },
        "supervision_control": {
          "human_supervision_mode": "delegated_with_audit",
          "manual_review_required": false,
          "fallback_to_human_on_risk": true
        }
      }
    }
  ]
}

import json
import sys
from datetime import datetime
from pathlib import Path

CURRENT_FILE = Path(__file__).resolve()
PROJECT_ROOT = CURRENT_FILE.parents[2]
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from qianqiu_os.services.runtime_alert_guard_v1 import RuntimeAlertGuardV1
from qianqiu_os.services.runtime_self_heal_guard_v1 import RuntimeSelfHealGuardV1
from qianqiu_os.services.runtime_reflection_check_v1 import RuntimeReflectionCheckV1
from qianqiu_os.services.runtime_human_loop_guard_v1 import RuntimeHumanLoopGuardV1
from qianqiu_os.services.runtime_knowledge_graph_v1 import RuntimeKnowledgeGraphV1
from qianqiu_os.services.runtime_promotion_guard_v1 import RuntimePromotionGuardV1
from qianqiu_os.services.runtime_time_logic_executor_v1 import RuntimeTimeLogicExecutorV1
from qianqiu_os.services.runtime_direction_check_v1 import RuntimeDirectionCheckV1
from qianqiu_os.services.runtime_memory_index_v1 import RuntimeMemoryIndexV1
from qianqiu_os.services.runtime_scheduling_overview_v1 import RuntimeSchedulingOverviewV1
from qianqiu_os.services.runtime_planning_engine_v1 import RuntimePlanningEngineV1
from qianqiu_os.services.runtime_agent_registry_v1 import RuntimeAgentRegistryV1
from qianqiu_os.services.wolong_business_judgement_v1 import WolongBusinessJudgementV1

BASE_DIR = Path(__file__).resolve().parents[1]
ACTIVE_CONFIG_PATH = BASE_DIR / "runtime_governance" / "delegation_active_config.json"
PREVIEW_FILE_PATH = BASE_DIR / "services" / "h5_delegation_active_config_preview_v1.py"
REGRESSION_OUTPUT_PATH = BASE_DIR / "runtime_governance" / "regression" / "runtime_regression_result_v3.json"

class RuntimeRegressionSuiteV1:
    def _now_str(self):
        return datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    def _read_json(self, path: Path):
        if not path.exists():
            return None
        try:
            with open(path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return None

    def _write_json(self, path: Path, data: dict):
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

    def run(self):
        checks = []

        active_config = self._read_json(ACTIVE_CONFIG_PATH)
        checks.append({"name": "active_config_exists", "passed": active_config is not None, "detail": "delegation_active_config.json exists" if active_config is not None else "missing"})

        whatsapp_control = (active_config or {}).get("whatsapp_control", {}) or {}
        checks.append({"name": "whatsapp_control_exists", "passed": bool(whatsapp_control), "detail": "whatsapp_control found" if whatsapp_control else "missing"})

        checks.append({
            "name": "readonly_baseline",
            "passed": whatsapp_control.get("ingress_mode") == "readonly" and whatsapp_control.get("auto_reply") is False and whatsapp_control.get("auto_dispatch") is False,
            "detail": {
                "ingress_mode": whatsapp_control.get("ingress_mode"),
                "auto_reply": whatsapp_control.get("auto_reply"),
                "auto_dispatch": whatsapp_control.get("auto_dispatch"),
            },
        })

        checks.append({"name": "preview_module_exists", "passed": PREVIEW_FILE_PATH.exists(), "detail": str(PREVIEW_FILE_PATH)})

        alert_result = RuntimeAlertGuardV1().evaluate()
        checks.append({"name": "alert_guard_healthy", "passed": alert_result.get("overall_status") == "healthy", "detail": alert_result.get("overall_status")})

        self_heal_result = RuntimeSelfHealGuardV1().run(auto_apply=False)
        checks.append({"name": "self_heal_runs", "passed": isinstance(self_heal_result, dict), "detail": self_heal_result.get("final_whatsapp_control", {})})

        reflection_result = RuntimeReflectionCheckV1().run()
        checks.append({"name": "reflection_check_runs", "passed": isinstance(reflection_result, dict) and bool(reflection_result.get("reflection_notes")), "detail": reflection_result.get("reflection_notes", [])})

        human_loop_result = RuntimeHumanLoopGuardV1().evaluate({"requested_action": "customer_send", "risk_level": "medium", "business_stage": "negotiating", "source": "whatsapp"})
        checks.append({"name": "human_loop_keeps_human_authority", "passed": human_loop_result.get("human_final_authority") is True and human_loop_result.get("human_confirmation_required") is True, "detail": {"final_decision": human_loop_result.get("final_decision"), "reason": human_loop_result.get("reason")}})

        knowledge_graph_result = RuntimeKnowledgeGraphV1().build_graph()
        checks.append({"name": "knowledge_graph_not_empty", "passed": knowledge_graph_result.get("node_count", 0) > 0 and knowledge_graph_result.get("edge_count", 0) > 0, "detail": {"node_count": knowledge_graph_result.get("node_count"), "edge_count": knowledge_graph_result.get("edge_count")}})

        promotion_result = RuntimePromotionGuardV1().evaluate({
            "promotion_master_switch": False,
            "gray_release_enabled": True,
            "human_final_confirmation": True,
            "daily_limit": 20,
            "whitelist_enabled": True,
            "rollback_enabled": True,
            "audit_required": True,
            "requested_action": "promotion_send",
        })
        checks.append({"name": "promotion_guard_safe_by_default", "passed": promotion_result.get("final_decision") == "blocked" and promotion_result.get("reason") == "promotion_master_switch_off", "detail": {"final_decision": promotion_result.get("final_decision"), "reason": promotion_result.get("reason")}})

        time_logic_result = RuntimeTimeLogicExecutorV1().build()
        checks.append({"name": "time_logic_runs", "passed": isinstance(time_logic_result, dict) and bool(time_logic_result.get("daily_night_summary")), "detail": time_logic_result.get("conclusion")})

        direction_result = RuntimeDirectionCheckV1().build()
        checks.append({"name": "direction_check_runs", "passed": direction_result.get("current_judgement", {}).get("direction_status") == "on_track", "detail": direction_result.get("current_judgement", {})})

        memory_result = RuntimeMemoryIndexV1().build()
        checks.append({"name": "memory_index_runs", "passed": memory_result.get("project_memory_file_count", 0) > 0 and len(memory_result.get("key_files", [])) >= 3, "detail": {"project_memory_file_count": memory_result.get("project_memory_file_count"), "key_files": len(memory_result.get("key_files", []))}})

        scheduling_result = RuntimeSchedulingOverviewV1().build()
        checks.append({"name": "scheduling_overview_runs", "passed": isinstance(scheduling_result, dict) and bool(scheduling_result.get("delegation_policy_keys")) is not None, "detail": scheduling_result.get("conclusion")})

        planning_result = RuntimePlanningEngineV1().build()
        checks.append({"name": "planning_engine_runs", "passed": len(planning_result.get("prioritized_actions", [])) >= 3, "detail": planning_result.get("prioritized_actions", [])})

        registry_result = RuntimeAgentRegistryV1().build()
        checks.append({"name": "agent_registry_runs", "passed": registry_result.get("agent_count", 0) >= 5, "detail": {"agent_count": registry_result.get("agent_count"), "core_strategy": registry_result.get("core_strategy")}})

        wolong_judgement_result = WolongBusinessJudgementV1().build()
        checks.append({"name": "wolong_business_judgement_runs", "passed": wolong_judgement_result.get("count", 0) > 0 and len(wolong_judgement_result.get("items", [])) > 0, "detail": {"count": wolong_judgement_result.get("count"), "conclusion": wolong_judgement_result.get("conclusion")}})

        passed_count = len([c for c in checks if c["passed"]])
        failed_count = len(checks) - passed_count
        overall_status = "passed" if failed_count == 0 else "failed"

        result = {
            "checked_at": self._now_str(),
            "suite_name": "runtime_regression_suite_v1",
            "overall_status": overall_status,
            "passed_count": passed_count,
            "failed_count": failed_count,
            "checks": checks,
        }

        self._write_json(REGRESSION_OUTPUT_PATH, result)
        return result

if __name__ == "__main__":
    print(json.dumps(RuntimeRegressionSuiteV1().run(), ensure_ascii=False, indent=2))

    text-shadow: 1.7px 1.06px 0 #0D1E2F;
}

#comp-k8syzav8 .style-k947t5tp__root:disabled{background: #E2E2E2}

#comp-k8syzav8 .style-k947t5tp__root:disabled .StylableButton2545352419__label{color: #8F8F8F}


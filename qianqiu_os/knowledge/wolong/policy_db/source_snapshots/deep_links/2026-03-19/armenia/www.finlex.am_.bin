#comp-k8syzav8 .style-k947t5tp__root{-st-extends: StylableButton;transition: all 0.2s ease;border-radius: 0px;background: #76BF4D;border: 0px solid rgb(13, 30, 47)}

/* START STYLABLE DIRECTIVE RULES */

#comp-k8syzav8 .style-k947t5tp__root:hover{padding-top: 3px;border-top: 4px solid rgb(13, 30, 47)}


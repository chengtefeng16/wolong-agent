from __future__ import annotations

from pathlib import Path
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, PageBreak
from reportlab.pdfbase.cidfonts import UnicodeCIDFont
from reportlab.pdfbase import pdfmetrics


def _register_fonts():
    try:
        pdfmetrics.registerFont(UnicodeCIDFont("STSong-Light"))
    except Exception:
        pass


def render_markdown_to_pdf(markdown_text: str, pdf_path: str | Path, title: str = "Document"):
    _register_fonts()
    pdf_path = Path(pdf_path)
    pdf_path.parent.mkdir(parents=True, exist_ok=True)

    styles = getSampleStyleSheet()
    base_font = "STSong-Light"

    title_style = ParagraphStyle(
        "CJKTitle",
        parent=styles["Title"],
        fontName=base_font,
        fontSize=20,
        leading=26,
        spaceAfter=10,
    )
    h1_style = ParagraphStyle(
        "CJKH1",
        parent=styles["Heading1"],
        fontName=base_font,
        fontSize=16,
        leading=22,
        spaceBefore=10,
        spaceAfter=8,
    )
    h2_style = ParagraphStyle(
        "CJKH2",
        parent=styles["Heading2"],
        fontName=base_font,
        fontSize=13,
        leading=18,
        spaceBefore=8,
        spaceAfter=6,
    )
    body_style = ParagraphStyle(
        "CJKBody",
        parent=styles["BodyText"],
        fontName=base_font,
        fontSize=10.5,
        leading=16,
        spaceAfter=4,
    )
    mono_style = ParagraphStyle(
        "CJKMono",
        parent=styles["Code"],
        fontName=base_font,
        fontSize=9.5,
        leading=14,
        leftIndent=10,
        spaceAfter=4,
    )

    def esc(text: str) -> str:
        return (
            text.replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
        )

    doc = SimpleDocTemplate(
        str(pdf_path),
        pagesize=A4,
        leftMargin=18 * mm,
        rightMargin=18 * mm,
        topMargin=18 * mm,
        bottomMargin=16 * mm,
        title=title,
        author="OpenAI / ChatGPT",
    )

    story = []
    story.append(Paragraph(esc(title), title_style))
    story.append(Spacer(1, 4))

    lines = markdown_text.splitlines()
    for raw in lines:
        line = raw.rstrip()

        if not line.strip():
            story.append(Spacer(1, 4))
            continue

        if line.startswith("# "):
            story.append(Paragraph(esc(line[2:].strip()), h1_style))
            continue

        if line.startswith("## "):
            story.append(Paragraph(esc(line[3:].strip()), h2_style))
            continue

        if line.startswith("### "):
            story.append(Paragraph(esc(line[4:].strip()), h2_style))
            continue

        if line.startswith("- "):
            story.append(Paragraph(esc("• " + line[2:].strip()), body_style))
            continue

        if line.startswith("```"):
            continue

        if line.startswith("    "):
            story.append(Paragraph(esc(line), mono_style))
            continue

        story.append(Paragraph(esc(line), body_style))

    def add_page_number(canvas, doc):
        canvas.saveState()
        canvas.setFont(base_font, 9)
        canvas.drawRightString(A4[0] - 18 * mm, 10 * mm, f"Page {doc.page}")
        canvas.restoreState()

    doc.build(story, onFirstPage=add_page_number, onLaterPages=add_page_number)
